page {
  background: #f8ecd0;
}

.index-page {
  padding-bottom: 180rpx;
}

.header {
  position: relative;
  min-height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #9f1d16;
  border-bottom: 4rpx solid #d9a441;
}

.cloud {
  position: absolute;
  top: 8rpx;
  width: 230rpx;
  height: 130rpx;
  opacity: 0.55;
}

.cloud-left {
  left: -30rpx;
}

.cloud-right {
  right: -30rpx;
  transform: scaleX(-1);
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #f8ecd0;
  letter-spacing: 8rpx;
}

.greeting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.greeting {
  font-size: 42rpx;
  font-weight: 800;
  color: #5a241d;
}

.mode-bar {
  display: flex;
  background: #fff7e0;
  border: 2rpx solid #d9a441;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 8rpx 0 20rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #6b4a35;
  font-size: 30rpx;
}

.mode-item.active {
  background: #9f1d16;
  color: #f2d9a4;
}

.combo-wrap {
  margin: 20rpx 0 8rpx;
}

.combo-label {
  color: #6b4a35;
  margin-bottom: 14rpx;
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  border: 2rpx solid #b3261e;
  color: #9f1d16;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
}

.chip-active {
  background: #b3261e;
  color: #ffe9b3;
}

.wheel-box {
  width: 460rpx;
  height: 460rpx;
  margin: 30rpx auto 0;
  position: relative;
}

.wheel {
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  border: 10rpx solid #d9a441;
  background: conic-gradient(
    #9f1d16 0deg 60deg,
    #f2c14e 60deg 120deg,
    #b3261e 120deg 180deg,
    #d9a441 180deg 240deg,
    #9f1d16 240deg 300deg,
    #f2c14e 300deg 360deg
  );
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(159, 29, 22, 0.3);
}

.wheel-sector {
  position: absolute;
  left: 50%;
  top: 50%;
  color: #ffe9b3;
  font-size: 26rpx;
  font-weight: 700;
  transform-origin: 0 0;
  white-space: nowrap;
}

.wheel-sector.s1 { transform: rotate(30deg) translate(160rpx); }
.wheel-sector.s2 { transform: rotate(90deg) translate(160rpx); }
.wheel-sector.s3 { transform: rotate(150deg) translate(160rpx); }
.wheel-sector.s4 { transform: rotate(210deg) translate(160rpx); }
.wheel-sector.s5 { transform: rotate(270deg) translate(160rpx); }
.wheel-sector.s6 { transform: rotate(330deg) translate(160rpx); }

.wheel-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 180rpx;
  height: 180rpx;
  transform: translate(-50%, -50%);
  background: #f8ecd0;
  border: 6rpx solid #9f1d16;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9f1d16;
}

.wheel-label {
  font-size: 26rpx;
}

.wheel-char {
  font-size: 64rpx;
  font-weight: 800;
}

.wheel-pointer {
  position: absolute;
  left: 50%;
  top: -16rpx;
  width: 0;
  height: 0;
  border-left: 24rpx solid transparent;
  border-right: 24rpx solid transparent;
  border-top: 48rpx solid #b3261e;
  transform: translateX(-50%);
  z-index: 2;
}

.draw-hero-sub {
  margin-top: 20rpx;
  text-align: center;
  color: #8a5a3b;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.jackpot-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 26rpx auto 0;
  color: #8a5a3b;
  font-size: 26rpx;
}

.result-card {
  background: #fff7e0;
  border: 2rpx solid #d9a441;
  border-radius: 8rpx;
  padding: 26rpx;
  margin-top: 26rpx;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  color: #5a241d;
  font-weight: 700;
}

.dish-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.dish-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #b3261e;
  border-radius: 6rpx;
  padding: 8rpx 16rpx;
  background: #f8ecd0;
}

.cat {
  color: #b3261e;
  font-size: 22rpx;
  border-right: 2rpx solid #d9a441;
  padding-right: 8rpx;
}

.dish-name {
  color: #5a241d;
  font-size: 28rpx;
}

.notice {
  color: #8a5a3b;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.nav-btn {
  flex: 1.2 !important;
}

.rest-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #5a241d;
}

.rest-addr,
.rest-note {
  color: #6b4a35;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.rest-distance {
  color: #b3261e;
  font-size: 26rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.outside-card {
  background: #fff7e0;
  border: 2rpx solid #d9a441;
  border-radius: 8rpx;
  padding: 28rpx;
}

.outside-tip {
  color: #8a5a3b;
  margin-bottom: 24rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.candidate-item {
  border: 2rpx solid #e2c68a;
  border-radius: 6rpx;
  padding: 16rpx;
  background: #f8ecd0;
}

.candidate-item.selected {
  border-color: #9f1d16;
  background: #fff7e0;
}

.candidate-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.candidate-name {
  font-size: 30rpx;
  color: #5a241d;
  font-weight: 700;
}

.favorite-tag {
  color: #9f1d16;
  border: 2rpx solid #9f1d16;
  border-radius: 4rpx;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
}

.candidate-meta {
  display: flex;
  gap: 20rpx;
  color: #8a5a3b;
  font-size: 24rpx;
  margin-top: 8rpx;
}
