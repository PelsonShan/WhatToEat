page {
  background: #f8ecd0;
}

.index-page {
  padding: 0 20rpx 180rpx;
}

.header {
  position: relative;
  background: #9f1d16;
  margin: 0 -20rpx;
}

.header-status {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 32rpx 10rpx;
  font-size: 28rpx;
  color: #f2d9a4;
}

.header-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-top: 2rpx solid #f2c14e;
  border-bottom: 2rpx solid #f2c14e;
}

.cloud-logo {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 90rpx;
  height: 54rpx;
  opacity: 0.85;
  background: url("/assets/cloud-v9.png") no-repeat center / contain;
}

.header-divider {
  height: 10rpx;
  background: repeating-linear-gradient(90deg, #d9a441 0 14rpx, #9f1d16 14rpx 18rpx);
}

.page-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #f8ecd0;
  letter-spacing: 8rpx;
  position: relative;
  z-index: 2;
}

.greeting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.greeting {
  font-size: 42rpx;
  font-weight: 800;
  color: #5a241d;
}

.mode-bar {
  display: flex;
  background: #fff7e0;
  border: 2rpx solid #d9a441;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 8rpx 0 20rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #6b4a35;
  font-size: 30rpx;
}

.mode-item.active {
  background: #9f1d16;
  color: #f8ecd0;
}

.combo-wrap {
  margin: 20rpx 0 8rpx;
}

.combo-label {
  color: #6b4a35;
  margin-bottom: 14rpx;
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  flex: 1;
  text-align: center;
  border: 2rpx solid #9f1d16;
  color: #9f1d16;
  border-radius: 8rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.chip-active {
  background: #9f1d16;
  color: #f8ecd0;
}

.wheel-box {
  width: 300rpx;
  height: 300rpx;
  margin: 34rpx auto 0;
  position: relative;
}

.wheel {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  border: 8rpx solid #d9a441;
  background: conic-gradient(#b3261e 0 25%, #f2c14e 25% 50%, #d9a441 50% 75%, #b3261e 75% 100%);
  box-shadow: 0 0 0 4rpx #9f1d16, 0 10rpx 28rpx rgba(159, 29, 22, 0.3);
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.wheel-center {
  position: absolute;
  inset: 42rpx;
  background: #f8ecd0;
  border: 4rpx solid #9f1d16;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9f1d16;
}

.wheel-label {
  font-size: 22rpx;
}

.wheel-char {
  font-size: 42rpx;
  font-weight: 800;
}

.wheel-pointer {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #d9a441;
  font-size: 34rpx;
  z-index: 2;
}

.draw-hero-sub {
  margin-top: 20rpx;
  text-align: center;
  color: #8a5a3b;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.jackpot-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 26rpx auto 0;
  color: #8a5a3b;
  font-size: 26rpx;
}

.result-card {
  background: #fff7e0;
  border: 2rpx dashed #b3261e;
  border-radius: 10rpx;
  padding: 26rpx;
  margin-top: 26rpx;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  color: #5a241d;
  font-weight: 700;
}

.dish-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.dish-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #d8b06a;
  border-radius: 28rpx;
  padding: 8rpx 20rpx;
  background: #fff7e0;
}

.cat {
  background: #9f1d16;
  color: #f8ecd0;
  font-size: 18rpx;
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
}

.dish-name {
  color: #5a241d;
  font-size: 26rpx;
}

.notice {
  color: #8a5a3b;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.nav-btn {
  flex: 1.2 !important;
}

.rest-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #5a241d;
}

.rest-addr,
.rest-note {
  color: #6b4a35;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.rest-distance {
  color: #b3261e;
  font-size: 26rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.outside-card {
  background: #fff7e0;
  border: 2rpx solid #d9a441;
  border-radius: 8rpx;
  padding: 28rpx;
}

.outside-tip {
  color: #8a5a3b;
  margin-bottom: 24rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.candidate-item {
  border: 2rpx solid #e2c68a;
  border-radius: 6rpx;
  padding: 16rpx;
  background: #f8ecd0;
}

.candidate-item.selected {
  border-color: #9f1d16;
  background: #fff7e0;
}

.candidate-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.candidate-name {
  font-size: 30rpx;
  color: #5a241d;
  font-weight: 700;
}

.favorite-tag {
  color: #9f1d16;
  border: 2rpx solid #9f1d16;
  border-radius: 4rpx;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
}

.candidate-meta {
  display: flex;
  gap: 20rpx;
  color: #8a5a3b;
  font-size: 24rpx;
  margin-top: 8rpx;
}
