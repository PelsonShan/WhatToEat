page {
  background: #f8ecd0;
}

.discover-page {
  padding-top: 20rpx;
}

.nearby-card {
  background: #fff7e0;
  border: 2rpx solid #d9a441;
  border-radius: 8rpx;
  padding: 24rpx;
}

.nearby-tip {
  color: #8a5a3b;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.poi-list,
.flavor-list,
.novelty-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.poi-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7e0;
  border: 2rpx solid #e2c68a;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
}

.poi-main {
  flex: 1;
  min-width: 0;
}

.poi-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.poi-name {
  font-size: 30rpx;
  color: #5a241d;
  font-weight: 700;
}

.favorite-tag {
  color: #9f1d16;
  border: 2rpx solid #9f1d16;
  border-radius: 4rpx;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
}

.poi-meta {
  display: flex;
  gap: 20rpx;
  color: #8a5a3b;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.cuisine-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cuisine-chip {
  border: 2rpx solid #b3261e;
  color: #9f1d16;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
}

.cuisine-chip.active {
  background: #b3261e;
  color: #ffe9b3;
}

.flavor-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7e0;
  border: 2rpx solid #e2c68a;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
}

.flavor-main {
  flex: 1;
  min-width: 0;
}

.flavor-name {
  display: block;
  font-size: 30rpx;
  color: #5a241d;
  font-weight: 700;
}

.flavor-sub {
  display: block;
  color: #8a5a3b;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.link.import {
  color: #9f1d16;
  border: 2rpx solid #9f1d16;
  border-radius: 4rpx;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
}
